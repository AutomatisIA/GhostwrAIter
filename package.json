{
  "name": "ghostwraiter",
  "version": "1.4.0",
  "private": true,
  "author": {
    "name": "Philippe Cohen",
    "email": "contact@AutomatisIA.fr"
  },
  "description": "Local-first desktop app for producing professional LinkedIn posts with AI.",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:native:electron && electron-vite dev",
    "build": "npm run rebuild:native:electron && electron-vite build",
    "preview": "electron-vite preview",
    "open:mac:latest": "./scripts/open-mac-latest.sh",
    "make:mac-launcher": "node scripts/build-mac-launcher.mjs",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "npm run rebuild:native:node && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:init": "node scripts/init-workspace.mjs",
    "package:mac": "npm run build && electron-builder --mac dir",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "rebuild:native:node": "node scripts/rebuild-native-node.mjs",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "verify-hardening": "node scripts/verify-hardening.mjs",
    "eval:editorial": "node scripts/eval-editorial-quality.mjs"
  },
  "build": {
    "appId": "fr.automatisia.ghostwraiter",
    "productName": "GhostwrAIter",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*",
      "out/renderer/**/*",
      "skills/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ],
      "icon": "resources/icons/icon.png"
    },
    "dmg": {
      "title": "GhostwrAIter",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-log": "^5.4.3",
    "motion": "^12.40.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  }
}
