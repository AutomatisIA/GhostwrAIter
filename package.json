{
  "name": "linkedin-poster",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first LinkedIn editorial cockpit powered by Codex skills.",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:native:electron && electron-vite dev",
    "build": "npm run rebuild:native:electron && electron-vite build",
    "preview": "electron-vite preview",
    "open:mac:latest": "./scripts/open-mac-latest.sh",
    "make:mac-launcher": "node scripts/build-mac-launcher.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run rebuild:native:node && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:init": "node scripts/init-workspace.mjs",
    "package:mac": "npm run build && electron-builder --mac dir",
    "rebuild:native:node": "PYTHON=/usr/bin/python3 npm rebuild better-sqlite3",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.philippe.linkedin-poster",
    "productName": "LinkedIn Poster",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*",
      "out/renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "electron-log": "^5.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
